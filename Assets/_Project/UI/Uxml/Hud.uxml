<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="screen-hud" class="screen" picking-mode="Ignore">
        <ui:VisualElement class="hud-top" picking-mode="Ignore">
            <ui:VisualElement class="row" style="align-items: flex-start;" picking-mode="Ignore">
                <ui:VisualElement class="portrait-frame" picking-mode="Ignore">
                    <ui:VisualElement name="img-portrait" class="portrait-img" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement style="width: 360px; margin-left: 10px;" picking-mode="Ignore">
                    <ui:Label name="label-name" picking-mode="Ignore" />
                    <ui:VisualElement name="bar-hp" class="bar" picking-mode="Ignore"><ui:VisualElement name="bar-hp-fill" class="bar-fill hp-fill" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:Label name="label-hp" class="small" picking-mode="Ignore" />
                    <ui:VisualElement name="bar-xp" class="bar" picking-mode="Ignore"><ui:VisualElement name="bar-xp-fill" class="bar-fill xp-fill" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:Label name="label-level" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hud-center" picking-mode="Ignore">
                <ui:Label name="label-time" class="hud-time" picking-mode="Ignore" />
                <ui:Label name="label-boss-next" class="boss-next" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="side" picking-mode="Ignore">
                <ui:Button name="btn-hud-menu" text="#hud_menu" class="btn" style="align-self: flex-end; font-size: 18px;" />
                <ui:VisualElement name="list-allies" picking-mode="Ignore" />
                <ui:Label name="label-synergy" class="small" style="color: rgb(255, 61, 240);" picking-mode="Ignore" />
                <ui:Label text="#hud_evolucoes" class="small" picking-mode="Ignore" />
                <ui:VisualElement name="list-evolutions" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="boss-bar" class="boss-bar" picking-mode="Ignore">
            <ui:VisualElement class="row boss-bar-head" picking-mode="Ignore">
                <ui:Label name="label-boss-name" class="boss-name" picking-mode="Ignore" />
                <ui:Label name="label-boss-phase" class="boss-phase" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="bar boss-bar-track" picking-mode="Ignore"><ui:VisualElement name="bar-boss-fill" class="bar-fill boss-fill" picking-mode="Ignore" /></ui:VisualElement>
            <ui:Label name="label-boss-more" class="small" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="list-events" class="event-list" picking-mode="Ignore" />
        <ui:VisualElement name="event-toast" class="event-toast" picking-mode="Ignore">
            <ui:VisualElement name="img-event-toast" class="event-toast-icon" picking-mode="Ignore" />
            <ui:VisualElement class="event-toast-text" picking-mode="Ignore">
                <ui:Label name="label-event-title" class="event-title" picking-mode="Ignore" />
                <ui:Label name="label-event-banner" class="event-banner" picking-mode="Ignore" />
                <ui:Label name="label-event-desc" class="event-desc" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="label-banner" class="banner" picking-mode="Ignore" />
        <ui:Label name="label-warning" class="warning-line" picking-mode="Ignore" />
        <ui:VisualElement class="hud-bottom" picking-mode="Ignore">
            <ui:VisualElement name="list-abilities" class="row wrap" style="max-width: 900px;" picking-mode="Ignore" />
            <ui:VisualElement name="special" class="special" picking-mode="Ignore">
                <ui:VisualElement name="img-special" class="special-icon" picking-mode="Ignore" />
                <ui:Label name="label-special-key" class="special-key" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
