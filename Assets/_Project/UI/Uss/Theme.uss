/* Tema "noir industrial" — mesma paleta da pixel art (ArtSource/lib/palette.mjs). */
.root {
    flex-grow: 1;
    color: rgb(238, 241, 244);
    font-size: 26px;
}

.screen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    padding: 24px;
}

.dim { background-color: rgba(20, 22, 27, 0.92); }
.dim-light { background-color: rgba(20, 22, 27, 0.6); }
.center { align-items: center; justify-content: center; }
.row { flex-direction: row; align-items: center; }
.wrap { flex-wrap: wrap; }
.grow { flex-grow: 1; }

.title { font-size: 76px; color: rgb(255, 210, 63); -unity-text-align: middle-center; text-shadow: 4px 4px 0 rgb(20, 22, 27); }
.subtitle { font-size: 26px; color: rgb(201, 205, 210); -unity-text-align: middle-center; margin-bottom: 16px; text-shadow: 3px 3px 0 rgb(20, 22, 27); }
.heading { font-size: 40px; color: rgb(255, 210, 63); margin-bottom: 12px; text-shadow: 4px 4px 0 rgb(20, 22, 27); }
.center-text { -unity-text-align: middle-center; }
.section-label { font-size: 22px; color: rgb(63, 224, 255); margin-bottom: 6px; }

/* Fundo dos menus: o laboratório à noite, escurecido */
.menu-bg { background-image: url("/Assets/_Project/Art/UI/ui_menu_bg.png"); -unity-background-scale-mode: scale-and-crop; background-color: rgb(22, 24, 31); }
.shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(14, 16, 21, 0.72); }
.shade-light { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(14, 16, 21, 0.35); }
.menu-layout { flex-grow: 1; align-items: center; justify-content: center; padding-bottom: 110px; }
.hero-lineup { position: absolute; left: 0; right: 0; bottom: 14px; flex-direction: row; justify-content: center; }
.hero-lineup > * { margin: 0 4px; }
.small { font-size: 22px; color: rgb(167, 176, 187); }
.warn { color: rgb(255, 144, 144); }
.ok { color: rgb(77, 255, 136); }
.footer { position: absolute; bottom: 12px; right: 18px; font-size: 20px; color: rgb(125, 135, 148); }

.panel {
    background-image: url("/Assets/_Project/Art/UI/ui_frame.png");
    -unity-slice-left: 8; -unity-slice-right: 8; -unity-slice-top: 8; -unity-slice-bottom: 8;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    padding: 20px 20px 16px 20px;
    margin: 6px;
    flex-shrink: 0;
}

.menu-panel { width: 460px; }

.btn {
    background-image: url("/Assets/_Project/Art/UI/ui_btn.png");
    -unity-slice-left: 5; -unity-slice-right: 5; -unity-slice-top: 5; -unity-slice-bottom: 5;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: rgb(238, 241, 244);
    font-size: 26px;
    padding: 6px 14px;
    margin: 4px;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 0 rgb(20, 22, 27);
    transition-duration: 0.08s;
    transition-property: translate;
}
.btn:hover { background-image: url("/Assets/_Project/Art/UI/ui_btn_hover.png"); color: rgb(255, 226, 122); translate: 0 -2px; }
.btn:active { translate: 0 2px; }
.btn.selected { background-image: url("/Assets/_Project/Art/UI/ui_btn_selected.png"); color: rgb(176, 243, 255); }
.btn.primary { background-image: url("/Assets/_Project/Art/UI/ui_btn_primary.png"); color: rgb(255, 255, 255); }
.btn.primary:hover { background-image: url("/Assets/_Project/Art/UI/ui_btn_hover.png"); }
.btn:disabled { color: rgb(125, 135, 148); translate: 0 0; }
.big { height: 50px; font-size: 30px; min-width: 150px; }

/* Escolha de personagem */
.setup-layout { flex-grow: 1; align-items: center; justify-content: center; }
.setup-row { align-items: stretch; }
.pick-panel { width: 790px; }
.hero-grid { justify-content: center; }
.hero-card { width: 140px; height: 150px; flex-direction: column; align-items: center; justify-content: flex-start; padding: 8px 4px; margin: 4px; }
.hero-card .portrait { width: 76px; height: 76px; flex-shrink: 0; margin-bottom: 2px; }
.hero-card .spec-name { font-size: 26px; color: rgb(255, 210, 63); -unity-text-align: middle-center; }
.hero-card .spec-eng { font-size: 16px; color: rgb(167, 176, 187); -unity-text-align: middle-center; white-space: normal; }
.hero-card-small { width: 96px; height: 92px; flex-direction: column; align-items: center; padding: 6px 3px; margin: 3px; }
.hero-card-small .portrait { width: 52px; height: 52px; flex-shrink: 0; }
.hero-card-small .spec-name { font-size: 18px; color: rgb(255, 210, 63); }
.summary-panel { width: 400px; align-items: stretch; }
.summary-stage { height: 140px; align-items: center; justify-content: flex-end; background-color: rgba(20, 22, 27, 0.6); margin-bottom: 10px; }
.summary-name { font-size: 36px; color: rgb(255, 210, 63); -unity-text-align: middle-center; text-shadow: 3px 3px 0 rgb(20, 22, 27); }
.summary-bio { font-size: 18px; color: rgb(238, 241, 244); white-space: normal; -unity-text-align: middle-center; margin: 8px 0 10px 0; -unity-font-style: italic; }
.summary-row { margin: 3px 0; min-height: 46px; flex-shrink: 0; }
.summary-icon { width: 44px; height: 44px; margin-right: 12px; flex-shrink: 0; }
.summary-item { font-size: 21px; white-space: normal; }
.bottom-row { width: 1200px; justify-content: space-between; align-items: center; }
.diff-panel { width: 760px; }
.diff-panel .small { white-space: normal; }
.action-row { justify-content: flex-end; }

/* Ficha do personagem */
.sheet-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(10, 11, 15, 0.86); align-items: center; justify-content: center; }
.sheet-panel { width: 1180px; height: 670px; padding-top: 30px; }
.sheet-columns { flex-direction: row; flex-grow: 1; flex-shrink: 1; }
.sheet-left { width: 280px; align-items: center; margin-right: 24px; flex-shrink: 0; }
.sheet-portrait { width: 176px; height: 176px; flex-shrink: 0; border-width: 4px; border-color: rgb(20, 22, 27); }
.sheet-stage { width: 230px; height: 128px; align-items: center; justify-content: flex-end; background-color: rgba(20, 22, 27, 0.7); margin: 14px 0; }
.sheet-name { font-size: 44px; color: rgb(255, 210, 63); text-shadow: 4px 4px 0 rgb(20, 22, 27); }
.sheet-eng { font-size: 19px; color: rgb(63, 224, 255); }
.sheet-right { flex-grow: 1; flex-shrink: 1; }
.sheet-bio { font-size: 21px; white-space: normal; -unity-font-style: italic; color: rgb(238, 241, 244); margin-bottom: 14px; }
.sheet-section { align-items: flex-start; margin-top: 14px; padding-top: 10px; border-top-width: 2px; border-top-color: rgb(62, 68, 78); }
.sheet-icon { width: 56px; height: 56px; margin-right: 16px; flex-shrink: 0; }
.sheet-kind { font-size: 17px; color: rgb(63, 224, 255); }
.sheet-title { font-size: 28px; color: rgb(255, 210, 63); }
.sheet-desc { font-size: 19px; white-space: normal; flex-shrink: 1; color: rgb(221, 225, 230); }
.sheet-list { margin-left: 72px; margin-top: 4px; }
.sheet-bullet { align-items: flex-start; margin: 2px 0; }
.sheet-level { font-size: 19px; color: rgb(167, 176, 187); width: 80px; flex-shrink: 0; }
.sheet-level-hi { font-size: 19px; color: rgb(255, 61, 240); width: 80px; flex-shrink: 0; }
.sheet-req { margin-left: 72px; margin-top: 6px; flex-wrap: wrap; }
.sheet-label { font-size: 18px; color: rgb(167, 176, 187); margin-right: 8px; }
.chip { flex-direction: row; align-items: center; background-color: rgba(20, 22, 27, 0.8); border-width: 2px; border-color: rgb(90, 98, 109); padding: 2px 10px 2px 4px; margin: 3px 6px 3px 0; }
.chip Label { font-size: 18px; }
.chip-icon { width: 32px; height: 32px; margin-right: 6px; }
.sheet-buttons { justify-content: flex-end; margin-top: 14px; }

.spec-card { width: 420px; min-height: 220px; flex-direction: row; align-items: flex-start; -unity-text-align: upper-left; white-space: normal; }
.spec-card .portrait { width: 128px; height: 128px; margin-right: 12px; flex-shrink: 0; }
.spec-card Label { white-space: normal; font-size: 22px; }
.spec-card .spec-name { font-size: 30px; color: rgb(232, 185, 35); }

TextField { font-size: 28px; }
TextField > .unity-text-field__input {
    background-color: rgb(20, 22, 27);
    border-color: rgb(125, 135, 148);
    color: rgb(238, 241, 244);
    font-size: 28px;
    -unity-font-style: normal;
}
.unity-base-field__label { color: rgb(201, 205, 210); min-width: 260px; font-size: 26px; }
Slider { margin: 8px 0; }
Toggle { margin: 8px 0; }

/* HUD */
.bar { height: 22px; background-color: rgb(20, 22, 27); border-width: 2px; border-color: rgb(90, 98, 109); }
.bar-fill { height: 100%; }
.hp-fill { background-color: rgb(224, 58, 58); }
.xp-fill { background-color: rgb(63, 224, 255); }
.ally-fill { background-color: rgb(77, 255, 136); }
.timer-fill { background-color: rgb(232, 185, 35); }
.hud-top { position: absolute; top: 12px; left: 12px; right: 12px; flex-direction: row; justify-content: space-between; align-items: flex-start; }
.hud-bottom { position: absolute; bottom: 12px; left: 12px; right: 12px; flex-direction: row; align-items: flex-end; justify-content: space-between; }
.portrait-frame { width: 136px; height: 136px; padding: 4px; background-color: rgb(20, 22, 27); border-width: 2px; border-color: rgb(90, 98, 109); }
.portrait-img { flex-grow: 1; }
.hud-time { font-size: 48px; color: rgb(238, 241, 244); -unity-text-align: upper-center; }
.ability { width: 72px; height: 72px; margin: 3px; background-color: rgba(20, 22, 27, 0.85); border-width: 2px; border-color: rgb(90, 98, 109); }
.ability-icon { position: absolute; left: 4px; top: 4px; width: 64px; height: 64px; }
.ability-level { position: absolute; right: 2px; bottom: -4px; font-size: 24px; color: rgb(255, 226, 122); }
.special { width: 104px; height: 104px; margin-left: 12px; background-color: rgba(20, 22, 27, 0.85); border-width: 3px; border-color: rgb(232, 185, 35); }
.special-icon { position: absolute; left: 4px; top: 4px; right: 4px; bottom: 4px; }
.special-key { position: absolute; bottom: -30px; left: 0; right: 0; font-size: 22px; -unity-text-align: middle-center; }
.banner { position: absolute; top: 110px; left: 0; right: 0; font-size: 40px; color: rgb(255, 181, 46); -unity-text-align: middle-center; }
.warning-line { position: absolute; top: 160px; left: 0; right: 0; font-size: 28px; color: rgb(255, 144, 144); -unity-text-align: middle-center; }
.side { width: 330px; }
.ally { width: 230px; margin-bottom: 6px; }

/* Cartas de subida de nível */
.card { width: 340px; min-height: 380px; flex-direction: column; align-items: stretch; justify-content: flex-start; padding: 14px; white-space: normal; -unity-text-align: upper-left; }
.card Label { white-space: normal; -unity-text-align: upper-left; }
.card-icon { width: 64px; height: 64px; align-self: center; margin: 6px; }
.card-kind { font-size: 22px; color: rgb(63, 224, 255); }
.card-name { font-size: 32px; color: rgb(232, 185, 35); }
.card-rarity { font-size: 22px; }
.card-desc { font-size: 22px; }
.card-change { font-size: 22px; color: rgb(77, 255, 136); }
.card-tags { font-size: 20px; color: rgb(167, 176, 187); }
.card-hint { font-size: 22px; color: rgb(255, 61, 240); }
.rarity-comum { color: rgb(201, 205, 210); }
.rarity-incomum { color: rgb(63, 224, 255); }
.rarity-raro { color: rgb(255, 61, 240); }

.result-panel { width: 760px; }
.message-panel { width: 640px; align-items: center; }
.message-panel Label { white-space: normal; -unity-text-align: middle-center; }

/* telas de menu com o laboratório ao fundo, mais escuro */
.menu-bg.dim { -unity-background-image-tint-color: rgb(80, 84, 94); }

/* rolagem da ficha no tema escuro */
.sheet-right .unity-scroller--vertical { width: 14px; }
.sheet-right .unity-scroller__slider .unity-base-slider__tracker { background-color: rgb(20, 22, 27); border-width: 0; }
.sheet-right .unity-scroller__slider .unity-base-slider__dragger { background-color: rgb(232, 185, 35); border-width: 0; }
.sheet-right .unity-scroller__low-button, .sheet-right .unity-scroller__high-button { display: none; }
